<Window x:Class="Emke.AiMarker.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SettingsTitle}"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        Foreground="{StaticResource PrimaryTextBrush}"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="20"
                   FontWeight="SemiBold"
                   Text="{DynamicResource SettingsTitle}" />
        <GroupBox Grid.Row="1"
                  Margin="0,18,0,0"
                  Header="{DynamicResource AdvancedHeading}">
            <StackPanel Margin="12">
                <CheckBox Content="{DynamicResource OverwriteOriginalsSetting}"
                          IsChecked="{Binding IsOverwriteOriginals, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="24,8,0,0"
                           Foreground="{StaticResource DangerBrush}"
                           Text="{DynamicResource AdvancedWarning}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </GroupBox>
        <Button Grid.Row="2"
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                IsCancel="True"
                Content="{DynamicResource SettingsDoneButton}"
                Click="DoneButton_OnClick" />
    </Grid>
</Window>
