<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <AssemblyName>EMKE AI Marker</AssemblyName>
    <ApplicationIcon Condition="Exists('Assets\emke-ai-marker.ico')">Assets\emke-ai-marker.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Emke.AiMarker.Core\Emke.AiMarker.Core.csproj" />
    <ProjectReference Include="..\Emke.AiMarker.Infrastructure\Emke.AiMarker.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\emke-app-logo-32.png" />
    <Resource Include="Assets\emke-app-logo-256.png" />
  </ItemGroup>

</Project>
